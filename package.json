{
  "name": "sof-pi",
  "version": "0.0.0",
  "private": true,
  "description": "Personal pi package — workflows and resources for Sofiane.",
  "keywords": [
    "pi-package"
  ],
  "license": "Apache-2.0",
  "readme": "README.md",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/factory/*.test.ts tests/perplexity/*.test.ts",
    "test:perplexity:integration": "SOF_PI_SUBAGENTS_INTEGRATION=1 node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/perplexity/tools.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/*.ts",
      "./extensions/perplexity/index.ts",
      "./extensions/background-terminals/index.ts",
      "./extensions/learning/index.ts",
      "./extensions/factory/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "dependencies": {
    "htmlparser2": "10.0.0",
    "ipaddr.js": "2.5.0"
  },
  "peerDependencies": {
    "typebox": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": "7.6.5"
    }
  }
}
